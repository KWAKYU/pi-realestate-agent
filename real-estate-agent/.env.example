# ─────────────────────────────────────────────────────────────
#  환경변수 설정 — 이 파일을 ".env" 로 복사해서 값을 채우세요
#    cp .env.example .env
# ─────────────────────────────────────────────────────────────

# 1) 국토교통부 실거래가 API 키 (data.go.kr)
#    발급: https://www.data.go.kr/data/15057511/openapi.do
#          → 활용신청(무료·즉시) → 마이페이지에서 "일반 인증키(Decoding)" 복사
#    ⚠️ Decoding 키(원본)를 넣으세요. Encoding 키(%2B %2F %3D 포함) 아님.
DATA_GO_KR_KEY=여기에_data.go.kr_일반인증키_Decoding

# 2) OpenRouter API 키 (AI 채팅 / Pi 에이전트 모델)
#    발급: https://openrouter.ai/keys   (sk-or-v1-... 형식)
OPENROUTER_API_KEY=sk-or-v1-여기에_openrouter_키

# 3) (선택) 모델 설정
#    OPENROUTER_MODEL : /api/chat(직접 호출) 모델
#    PI_MODEL         : Pi 에이전트가 OpenRouter에서 쓸 모델 ID
OPENROUTER_MODEL=openai/gpt-4o-mini
PI_MODEL=openai/gpt-mini-latest
